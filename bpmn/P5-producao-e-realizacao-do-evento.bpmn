        <bpmn:flowNodeRef>P5_t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P5_1" name="Equipe e fornecedores">
        <bpmn:flowNodeRef>P5_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P5_2" name="Sistema Palco">
        <bpmn:flowNodeRef>P5_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P5_start" name="Evento publicado">
      <bpmn:outgoing>Flow_P5_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P5_t1" name="Cadastrar atrações e fornecedores">
      <bpmn:incoming>Flow_P5_0</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P5_t2" name="Registrar contratos e cachês">
      <bpmn:incoming>Flow_P5_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P5_t3" name="Montar escala da equipe">
      <bpmn:incoming>Flow_P5_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P5_t4" name="Montar cronograma do dia">
      <bpmn:incoming>Flow_P5_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P5_t5" name="Notificar equipe e fornecedores">
      <bpmn:incoming>Flow_P5_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P5_t6" name="Executar montagem e passagem de som">
      <bpmn:incoming>Flow_P5_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P5_t7" name="Registrar presença da equipe">
      <bpmn:incoming>Flow_P5_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P5_t8" name="Marcar etapas concluídas">
