      <bpmn:incoming>Flow_P5_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_g1" name="Etapa atrasada?">
      <bpmn:incoming>Flow_P5_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_P5_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P5_t9" name="Recalcular etapas seguintes">
      <bpmn:incoming>Flow_P5_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P5_t10" name="Realizar o show">
      <bpmn:incoming>Flow_P5_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P5_t11" name="Encerrar sessão e registrar ocorrências">
      <bpmn:incoming>Flow_P5_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P5_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P5_end" name="Evento realizado">
      <bpmn:incoming>Flow_P5_13</bpmn:incoming>
    </bpmn:endEvent>
