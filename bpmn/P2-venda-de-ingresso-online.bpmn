<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P2" targetNamespace="http://palco.ifba/bpmn" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P2">
    <bpmn:participant id="Participant_P2" name="Bilheteria Palco" processRef="Process_P2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P2" name="Venda de ingresso online" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2">
      <bpmn:lane id="Lane_P2_0" name="Cliente">
        <bpmn:flowNodeRef>P2_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P2_1" name="Sistema Palco">
        <bpmn:flowNodeRef>P2_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_end2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P2_2" name="Provedor de pagamento">
        <bpmn:flowNodeRef>P2_t7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_start" name="Cliente procura um show">
      <bpmn:outgoing>Flow_P2_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P2_t1" name="Pesquisar eventos na vitrine">
      <bpmn:incoming>Flow_P2_0</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P2_t2" name="Selecionar sessão, setor e quantidade">
      <bpmn:incoming>Flow_P2_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P2_t3" name="Reservar ingressos por 15 minutos">
      <bpmn:incoming>Flow_P2_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P2_t4" name="Informar dados e aplicar cupom">
      <bpmn:incoming>Flow_P2_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_g0" name="Meia-entrada?">
      <bpmn:incoming>Flow_P2_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P2_t5" name="Anexar comprovante do benefício">
      <bpmn:incoming>Flow_P2_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P2_t6" name="Enviar cobrança ao provedor">
      <bpmn:incoming>Flow_P2_6</bpmn:incoming>
      <bpmn:incoming>Flow_P2_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P2_t7" name="Processar pagamento">
      <bpmn:incoming>Flow_P2_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2_g1" name="Pagamento aprovado?">
      <bpmn:incoming>Flow_P2_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_t8" name="Emitir ingressos com QR Code">
      <bpmn:incoming>Flow_P2_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P2_t9" name="Liberar reserva e avisar recusa">
      <bpmn:incoming>Flow_P2_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P2_t10" name="Enviar ingressos por e-mail">
      <bpmn:incoming>Flow_P2_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P2_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P2_end2" name="Compra não concluída">
      <bpmn:incoming>Flow_P2_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P2_end1" name="Compra concluída">
      <bpmn:incoming>Flow_P2_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P2_0" sourceRef="P2_start" targetRef="P2_t1" />
    <bpmn:sequenceFlow id="Flow_P2_1" sourceRef="P2_t1" targetRef="P2_t2" />
    <bpmn:sequenceFlow id="Flow_P2_2" sourceRef="P2_t2" targetRef="P2_t3" />
    <bpmn:sequenceFlow id="Flow_P2_3" sourceRef="P2_t3" targetRef="P2_t4" />
    <bpmn:sequenceFlow id="Flow_P2_4" sourceRef="P2_t4" targetRef="P2_g0" />
    <bpmn:sequenceFlow id="Flow_P2_5" name="sim" sourceRef="P2_g0" targetRef="P2_t5" />
    <bpmn:sequenceFlow id="Flow_P2_6" sourceRef="P2_t5" targetRef="P2_t6" />
    <bpmn:sequenceFlow id="Flow_P2_7" name="não" sourceRef="P2_g0" targetRef="P2_t6" />
    <bpmn:sequenceFlow id="Flow_P2_8" sourceRef="P2_t6" targetRef="P2_t7" />
    <bpmn:sequenceFlow id="Flow_P2_9" sourceRef="P2_t7" targetRef="P2_g1" />
    <bpmn:sequenceFlow id="Flow_P2_10" name="aprovado" sourceRef="P2_g1" targetRef="P2_t8" />
    <bpmn:sequenceFlow id="Flow_P2_11" name="recusado" sourceRef="P2_g1" targetRef="P2_t9" />
    <bpmn:sequenceFlow id="Flow_P2_12" sourceRef="P2_t8" targetRef="P2_t10" />
    <bpmn:sequenceFlow id="Flow_P2_13" sourceRef="P2_t9" targetRef="P2_end2" />
    <bpmn:sequenceFlow id="Flow_P2_14" sourceRef="P2_t10" targetRef="P2_end1" />
  </bpmn:process>
