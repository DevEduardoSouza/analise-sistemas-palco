<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P6" targetNamespace="http://palco.ifba/bpmn" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P6">
    <bpmn:participant id="Participant_P6" name="Financeiro Palco" processRef="Process_P6" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P6" name="Fechamento financeiro e repasse" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P6">
      <bpmn:lane id="Lane_P6_0" name="Sistema Palco">
        <bpmn:flowNodeRef>P6_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P6_1" name="Financeiro">
        <bpmn:flowNodeRef>P6_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P6_2" name="Produtor">
        <bpmn:flowNodeRef>P6_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P6_start" name="Fim da janela de reembolso">
      <bpmn:outgoing>Flow_P6_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P6_start" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P6_t1" name="Consolidar receita, taxas e descontos">
      <bpmn:incoming>Flow_P6_0</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P6_t2" name="Consolidar custos do evento">
      <bpmn:incoming>Flow_P6_1</bpmn:incoming>
      <bpmn:incoming>Flow_P6_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P6_t3" name="Conferir demonstrativo da sessão">
      <bpmn:incoming>Flow_P6_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P6_g1" name="Valores conferem?">
      <bpmn:incoming>Flow_P6_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P6_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P6_t4" name="Corrigir lançamentos">
      <bpmn:incoming>Flow_P6_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P6_t5" name="Fechar sessão e congelar valores">
      <bpmn:incoming>Flow_P6_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P6_t6" name="Gerar repasse ao produtor">
      <bpmn:incoming>Flow_P6_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P6_t7" name="Notificar produtor do fechamento">
      <bpmn:incoming>Flow_P6_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P6_t8" name="Consultar relatórios e exportar">
      <bpmn:incoming>Flow_P6_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P6_end" name="Fechamento concluído">
      <bpmn:incoming>Flow_P6_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P6_0" sourceRef="P6_start" targetRef="P6_t1" />
    <bpmn:sequenceFlow id="Flow_P6_1" sourceRef="P6_t1" targetRef="P6_t2" />
    <bpmn:sequenceFlow id="Flow_P6_2" sourceRef="P6_t2" targetRef="P6_t3" />
    <bpmn:sequenceFlow id="Flow_P6_3" sourceRef="P6_t3" targetRef="P6_g1" />
    <bpmn:sequenceFlow id="Flow_P6_4" name="não" sourceRef="P6_g1" targetRef="P6_t4" />
    <bpmn:sequenceFlow id="Flow_P6_5" sourceRef="P6_t4" targetRef="P6_t2" />
    <bpmn:sequenceFlow id="Flow_P6_6" name="sim" sourceRef="P6_g1" targetRef="P6_t5" />
    <bpmn:sequenceFlow id="Flow_P6_7" sourceRef="P6_t5" targetRef="P6_t6" />
    <bpmn:sequenceFlow id="Flow_P6_8" sourceRef="P6_t6" targetRef="P6_t7" />
    <bpmn:sequenceFlow id="Flow_P6_9" sourceRef="P6_t7" targetRef="P6_t8" />
    <bpmn:sequenceFlow id="Flow_P6_10" sourceRef="P6_t8" targetRef="P6_end" />
  </bpmn:process>
