    <bpmn:sequenceFlow id="Flow_P4_10" sourceRef="P4_t4" targetRef="P4_g2" />
    <bpmn:sequenceFlow id="Flow_P4_11" name="válido" sourceRef="P4_g2" targetRef="P4_t6" />
    <bpmn:sequenceFlow id="Flow_P4_12" name="meia ou nominal" sourceRef="P4_g2" targetRef="P4_t5" />
    <bpmn:sequenceFlow id="Flow_P4_13" name="inválido ou já usado" sourceRef="P4_g2" targetRef="P4_t7" />
    <bpmn:sequenceFlow id="Flow_P4_14" sourceRef="P4_t5" targetRef="P4_g3" />
    <bpmn:sequenceFlow id="Flow_P4_15" name="sim" sourceRef="P4_g3" targetRef="P4_t6" />
    <bpmn:sequenceFlow id="Flow_P4_16" name="não" sourceRef="P4_g3" targetRef="P4_t7" />
    <bpmn:sequenceFlow id="Flow_P4_17" sourceRef="P4_t6" targetRef="P4_t8" />
    <bpmn:sequenceFlow id="Flow_P4_18" sourceRef="P4_t8" targetRef="P4_end1" />
    <bpmn:sequenceFlow id="Flow_P4_19" sourceRef="P4_t7" targetRef="P4_end2" />
  </bpmn:process>
