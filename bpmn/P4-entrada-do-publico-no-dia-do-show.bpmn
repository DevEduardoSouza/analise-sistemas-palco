<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P4" targetNamespace="http://palco.ifba/bpmn" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P4">
    <bpmn:participant id="Participant_P4" name="Portaria Cena Livre" processRef="Process_P4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P4" name="Entrada do público no dia do show" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P4">
      <bpmn:lane id="Lane_P4_0" name="Público">
        <bpmn:flowNodeRef>P4_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P4_1" name="Portaria">
        <bpmn:flowNodeRef>P4_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_end2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P4_2" name="Bilheteria">
        <bpmn:flowNodeRef>P4_gb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_end3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P4_3" name="Aplicativo de portaria">
        <bpmn:flowNodeRef>P4_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P4_start" name="Passagem de som concluída">
      <bpmn:outgoing>Flow_P4_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P4_t1" name="Baixar ingressos e lista de convidados">
      <bpmn:incoming>Flow_P4_0</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P4_t2" name="Apresentar ingresso ou nome na lista">
      <bpmn:incoming>Flow_P4_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="P4_g1" name="Tem ingresso ou convite?">
      <bpmn:incoming>Flow_P4_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P4_t3" name="Ler QR Code ou buscar nome na lista">
      <bpmn:incoming>Flow_P4_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P4_b1" name="Verificar lotação disponível">
      <bpmn:incoming>Flow_P4_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P4_gb" name="Há lugar na casa?">
      <bpmn:incoming>Flow_P4_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P4_b2" name="Vender ingresso na porta">
      <bpmn:incoming>Flow_P4_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P4_end3" name="Casa lotada">
      <bpmn:incoming>Flow_P4_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P4_t4" name="Validar ingresso ou convite">
      <bpmn:incoming>Flow_P4_8</bpmn:incoming>
      <bpmn:incoming>Flow_P4_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P4_g2" name="Resultado da validação">
      <bpmn:incoming>Flow_P4_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P4_t5" name="Conferir documento do portador">
      <bpmn:incoming>Flow_P4_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P4_g3" name="Documento confere?">
      <bpmn:incoming>Flow_P4_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P4_t6" name="Registrar entrada e atualizar lotação">
      <bpmn:incoming>Flow_P4_11</bpmn:incoming>
      <bpmn:incoming>Flow_P4_15</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P4_t7" name="Negar entrada e informar motivo">
      <bpmn:incoming>Flow_P4_13</bpmn:incoming>
      <bpmn:incoming>Flow_P4_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P4_t8" name="Sincronizar entradas ao reconectar">
      <bpmn:incoming>Flow_P4_17</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P4_end2" name="Entrada negada">
      <bpmn:incoming>Flow_P4_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P4_end1" name="Público dentro da casa">
      <bpmn:incoming>Flow_P4_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P4_0" sourceRef="P4_start" targetRef="P4_t1" />
    <bpmn:sequenceFlow id="Flow_P4_1" sourceRef="P4_t1" targetRef="P4_t2" />
    <bpmn:sequenceFlow id="Flow_P4_2" sourceRef="P4_t2" targetRef="P4_g1" />
    <bpmn:sequenceFlow id="Flow_P4_3" name="sim" sourceRef="P4_g1" targetRef="P4_t3" />
    <bpmn:sequenceFlow id="Flow_P4_4" name="não" sourceRef="P4_g1" targetRef="P4_b1" />
    <bpmn:sequenceFlow id="Flow_P4_5" sourceRef="P4_b1" targetRef="P4_gb" />
    <bpmn:sequenceFlow id="Flow_P4_6" name="sim" sourceRef="P4_gb" targetRef="P4_b2" />
    <bpmn:sequenceFlow id="Flow_P4_7" name="não" sourceRef="P4_gb" targetRef="P4_end3" />
    <bpmn:sequenceFlow id="Flow_P4_8" sourceRef="P4_b2" targetRef="P4_t4" />
