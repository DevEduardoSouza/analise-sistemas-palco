<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P3" targetNamespace="http://palco.ifba/bpmn" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P3">
    <bpmn:participant id="Participant_P3" name="Pós-venda Cena Livre" processRef="Process_P3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P3" name="Cancelamento, remarcação e reembolso" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P3">
      <bpmn:lane id="Lane_P3_0" name="Cliente">
        <bpmn:flowNodeRef>P3_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_1" name="Dono e sócio">
        <bpmn:flowNodeRef>P3_start2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_2" name="Bilheteria">
        <bpmn:flowNodeRef>P3_t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_3" name="Sistema Palco">
        <bpmn:flowNodeRef>P3_r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_end3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_4" name="Provedor de pagamento">
        <bpmn:flowNodeRef>P3_t7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_start" name="Cliente pede devolução">
      <bpmn:outgoing>Flow_P3_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="P3_start2" name="Banda adia ou cancela o show">
      <bpmn:outgoing>Flow_P3_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P3_r1" name="Remarcar data ou cancelar o show">
      <bpmn:incoming>Flow_P3_0</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P3_r2" name="Avisar compradores e abrir prazo de reembolso">
      <bpmn:incoming>Flow_P3_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P3_end3" name="Compradores avisados">
      <bpmn:incoming>Flow_P3_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P3_t1" name="Solicitar cancelamento">
      <bpmn:incoming>Flow_P3_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P3_t2" name="Localizar compra e verificar política">
      <bpmn:incoming>Flow_P3_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_g1" name="Direito automático?">
      <bpmn:incoming>Flow_P3_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_P3_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P3_t3" name="Analisar pedido fora da política">
      <bpmn:incoming>Flow_P3_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_g2" name="Devolução aprovada?">
      <bpmn:incoming>Flow_P3_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_P3_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P3_t4" name="Notificar recusa com justificativa">
      <bpmn:incoming>Flow_P3_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P3_end2" name="Pedido recusado">
      <bpmn:incoming>Flow_P3_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P3_t5" name="Cancelar ingressos e devolver à cota">
      <bpmn:incoming>Flow_P3_10</bpmn:incoming>
      <bpmn:incoming>Flow_P3_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_g3" name="Canal da compra">
      <bpmn:incoming>Flow_P3_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_P3_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P3_t6" name="Solicitar estorno ao provedor">
      <bpmn:incoming>Flow_P3_13</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P3_t7" name="Processar estorno">
      <bpmn:incoming>Flow_P3_15</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P3_t8" name="Devolver valor ao comprador identificado">
      <bpmn:incoming>Flow_P3_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P3_t9" name="Registrar reembolso no financeiro do show">
      <bpmn:incoming>Flow_P3_16</bpmn:incoming>
      <bpmn:incoming>Flow_P3_17</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P3_end1" name="Reembolso concluído">
      <bpmn:incoming>Flow_P3_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P3_0" sourceRef="P3_start2" targetRef="P3_r1" />
    <bpmn:sequenceFlow id="Flow_P3_1" sourceRef="P3_r1" targetRef="P3_r2" />
    <bpmn:sequenceFlow id="Flow_P3_2" sourceRef="P3_r2" targetRef="P3_end3" />
    <bpmn:sequenceFlow id="Flow_P3_3" sourceRef="P3_start" targetRef="P3_t1" />
    <bpmn:sequenceFlow id="Flow_P3_4" sourceRef="P3_t1" targetRef="P3_t2" />
    <bpmn:sequenceFlow id="Flow_P3_5" sourceRef="P3_t2" targetRef="P3_g1" />
    <bpmn:sequenceFlow id="Flow_P3_6" name="não" sourceRef="P3_g1" targetRef="P3_t3" />
    <bpmn:sequenceFlow id="Flow_P3_7" sourceRef="P3_t3" targetRef="P3_g2" />
    <bpmn:sequenceFlow id="Flow_P3_8" name="não" sourceRef="P3_g2" targetRef="P3_t4" />
    <bpmn:sequenceFlow id="Flow_P3_9" sourceRef="P3_t4" targetRef="P3_end2" />
    <bpmn:sequenceFlow id="Flow_P3_10" name="sim" sourceRef="P3_g1" targetRef="P3_t5" />
    <bpmn:sequenceFlow id="Flow_P3_11" name="sim" sourceRef="P3_g2" targetRef="P3_t5" />
    <bpmn:sequenceFlow id="Flow_P3_12" sourceRef="P3_t5" targetRef="P3_g3" />
    <bpmn:sequenceFlow id="Flow_P3_13" name="online" sourceRef="P3_g3" targetRef="P3_t6" />
    <bpmn:sequenceFlow id="Flow_P3_14" name="porta ou parceiro" sourceRef="P3_g3" targetRef="P3_t8" />
    <bpmn:sequenceFlow id="Flow_P3_15" sourceRef="P3_t6" targetRef="P3_t7" />
    <bpmn:sequenceFlow id="Flow_P3_16" sourceRef="P3_t7" targetRef="P3_t9" />
    <bpmn:sequenceFlow id="Flow_P3_17" sourceRef="P3_t8" targetRef="P3_t9" />
    <bpmn:sequenceFlow id="Flow_P3_18" sourceRef="P3_t9" targetRef="P3_end1" />
  </bpmn:process>
