<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P4" targetNamespace="http://palco.ifba/bpmn" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P4">
    <bpmn:participant id="Participant_P4" name="Portaria do evento" processRef="Process_P4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P4" name="Check-in e controle de acesso" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P4">
      <bpmn:lane id="Lane_P4_0" name="Público">
        <bpmn:flowNodeRef>P4_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P4_1" name="Portaria">
        <bpmn:flowNodeRef>P4_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P4_2" name="Aplicativo de portaria">
        <bpmn:flowNodeRef>P4_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P4_start" name="Portões abertos">
      <bpmn:outgoing>Flow_P4_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P4_t1" name="Baixar lista de ingressos da sessão">
      <bpmn:incoming>Flow_P4_0</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P4_t2" name="Apresentar ingresso digital">
      <bpmn:incoming>Flow_P4_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P4_t3" name="Ler QR Code do ingresso">
      <bpmn:incoming>Flow_P4_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P4_t4" name="Validar assinatura e situação">
      <bpmn:incoming>Flow_P4_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P4_g1" name="Resultado da validação">
      <bpmn:incoming>Flow_P4_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P4_t5" name="Conferir documento do portador">
      <bpmn:incoming>Flow_P4_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P4_g2" name="Documento confere?">
      <bpmn:incoming>Flow_P4_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P4_t6" name="Registrar check-in e liberar acesso">
      <bpmn:incoming>Flow_P4_6</bpmn:incoming>
      <bpmn:incoming>Flow_P4_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P4_t7" name="Registrar recusa e orientar bilheteria">
      <bpmn:incoming>Flow_P4_7</bpmn:incoming>
      <bpmn:incoming>Flow_P4_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P4_t8" name="Sincronizar check-ins com o servidor">
      <bpmn:incoming>Flow_P4_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P4_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P4_end2" name="Acesso negado">
      <bpmn:incoming>Flow_P4_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P4_end1" name="Público no evento">
      <bpmn:incoming>Flow_P4_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P4_0" sourceRef="P4_start" targetRef="P4_t1" />
    <bpmn:sequenceFlow id="Flow_P4_1" sourceRef="P4_t1" targetRef="P4_t2" />
    <bpmn:sequenceFlow id="Flow_P4_2" sourceRef="P4_t2" targetRef="P4_t3" />
    <bpmn:sequenceFlow id="Flow_P4_3" sourceRef="P4_t3" targetRef="P4_t4" />
    <bpmn:sequenceFlow id="Flow_P4_4" sourceRef="P4_t4" targetRef="P4_g1" />
    <bpmn:sequenceFlow id="Flow_P4_5" name="nominal ou meia" sourceRef="P4_g1" targetRef="P4_t5" />
    <bpmn:sequenceFlow id="Flow_P4_6" name="válido" sourceRef="P4_g1" targetRef="P4_t6" />
    <bpmn:sequenceFlow id="Flow_P4_7" name="inválido ou usado" sourceRef="P4_g1" targetRef="P4_t7" />
    <bpmn:sequenceFlow id="Flow_P4_8" sourceRef="P4_t5" targetRef="P4_g2" />
    <bpmn:sequenceFlow id="Flow_P4_9" name="sim" sourceRef="P4_g2" targetRef="P4_t6" />
    <bpmn:sequenceFlow id="Flow_P4_10" name="não" sourceRef="P4_g2" targetRef="P4_t7" />
    <bpmn:sequenceFlow id="Flow_P4_11" sourceRef="P4_t6" targetRef="P4_t8" />
    <bpmn:sequenceFlow id="Flow_P4_12" sourceRef="P4_t8" targetRef="P4_end1" />
    <bpmn:sequenceFlow id="Flow_P4_13" sourceRef="P4_t7" targetRef="P4_end2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P4">
    <bpmndi:BPMNPlane id="Plane_P4" bpmnElement="Collaboration_P4">
      <bpmndi:BPMNShape id="Participant_P4_di" bpmnElement="Participant_P4" isHorizontal="true">
