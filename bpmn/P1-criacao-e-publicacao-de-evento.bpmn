<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P1" targetNamespace="http://palco.ifba/bpmn" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P1">
    <bpmn:participant id="Participant_P1" name="Plataforma Palco" processRef="Process_P1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" name="Criação e publicação de evento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P1">
      <bpmn:lane id="Lane_P1_0" name="Produtor">
        <bpmn:flowNodeRef>P1_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_1" name="Administrador da plataforma">
        <bpmn:flowNodeRef>P1_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_2" name="Sistema Palco">
        <bpmn:flowNodeRef>P1_t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_start" name="Produtor quer vender ingressos">
      <bpmn:outgoing>Flow_P1_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P1_t1" name="Cadastrar produtora e dados de recebimento">
      <bpmn:incoming>Flow_P1_0</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t2" name="Analisar cadastro da produtora">
      <bpmn:incoming>Flow_P1_1</bpmn:incoming>
      <bpmn:incoming>Flow_P1_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P1_g1" name="Cadastro aprovado?">
      <bpmn:incoming>Flow_P1_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P1_t3" name="Corrigir dados cadastrais">
      <bpmn:incoming>Flow_P1_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t4" name="Cadastrar local e setores">
      <bpmn:incoming>Flow_P1_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t5" name="Cadastrar evento">
      <bpmn:incoming>Flow_P1_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t6" name="Cadastrar sessões">
      <bpmn:incoming>Flow_P1_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t7" name="Configurar lotes e preços">
      <bpmn:incoming>Flow_P1_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t8" name="Submeter evento à análise">
      <bpmn:incoming>Flow_P1_9</bpmn:incoming>
      <bpmn:incoming>Flow_P1_13</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t9" name="Analisar evento">
      <bpmn:incoming>Flow_P1_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P1_g2" name="Evento aprovado?">
      <bpmn:incoming>Flow_P1_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P1_t10" name="Ajustar evento conforme parecer">
      <bpmn:incoming>Flow_P1_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P1_t11" name="Publicar evento na vitrine">
      <bpmn:incoming>Flow_P1_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P1_t12" name="Notificar produtor da publicação">
      <bpmn:incoming>Flow_P1_15</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P1_end" name="Evento publicado">
      <bpmn:incoming>Flow_P1_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1_0" sourceRef="P1_start" targetRef="P1_t1" />
    <bpmn:sequenceFlow id="Flow_P1_1" sourceRef="P1_t1" targetRef="P1_t2" />
    <bpmn:sequenceFlow id="Flow_P1_2" sourceRef="P1_t2" targetRef="P1_g1" />
    <bpmn:sequenceFlow id="Flow_P1_3" name="não" sourceRef="P1_g1" targetRef="P1_t3" />
    <bpmn:sequenceFlow id="Flow_P1_4" sourceRef="P1_t3" targetRef="P1_t2" />
    <bpmn:sequenceFlow id="Flow_P1_5" name="sim" sourceRef="P1_g1" targetRef="P1_t4" />
    <bpmn:sequenceFlow id="Flow_P1_6" sourceRef="P1_t4" targetRef="P1_t5" />
    <bpmn:sequenceFlow id="Flow_P1_7" sourceRef="P1_t5" targetRef="P1_t6" />
    <bpmn:sequenceFlow id="Flow_P1_8" sourceRef="P1_t6" targetRef="P1_t7" />
    <bpmn:sequenceFlow id="Flow_P1_9" sourceRef="P1_t7" targetRef="P1_t8" />
    <bpmn:sequenceFlow id="Flow_P1_10" sourceRef="P1_t8" targetRef="P1_t9" />
    <bpmn:sequenceFlow id="Flow_P1_11" sourceRef="P1_t9" targetRef="P1_g2" />
    <bpmn:sequenceFlow id="Flow_P1_12" name="não" sourceRef="P1_g2" targetRef="P1_t10" />
    <bpmn:sequenceFlow id="Flow_P1_13" sourceRef="P1_t10" targetRef="P1_t8" />
    <bpmn:sequenceFlow id="Flow_P1_14" name="sim" sourceRef="P1_g2" targetRef="P1_t11" />
    <bpmn:sequenceFlow id="Flow_P1_15" sourceRef="P1_t11" targetRef="P1_t12" />
    <bpmn:sequenceFlow id="Flow_P1_16" sourceRef="P1_t12" targetRef="P1_end" />
  </bpmn:process>
