<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P3" targetNamespace="http://palco.ifba/bpmn" exporter="gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P3">
    <bpmn:participant id="Participant_P3" name="Pós-venda Palco" processRef="Process_P3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P3" name="Cancelamento e reembolso" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P3">
      <bpmn:lane id="Lane_P3_0" name="Cliente">
        <bpmn:flowNodeRef>P3_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_1" name="Sistema Palco">
        <bpmn:flowNodeRef>P3_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_2" name="Financeiro">
        <bpmn:flowNodeRef>P3_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_3" name="Provedor de pagamento">
        <bpmn:flowNodeRef>P3_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_start" name="Cliente desiste da compra">
      <bpmn:outgoing>Flow_P3_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P3_t1" name="Solicitar cancelamento">
      <bpmn:incoming>Flow_P3_0</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P3_t2" name="Verificar política de cancelamento">
      <bpmn:incoming>Flow_P3_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_g1" name="Dentro da janela automática?">
      <bpmn:incoming>Flow_P3_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_P3_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P3_t3" name="Analisar solicitação">
      <bpmn:incoming>Flow_P3_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_g2" name="Reembolso aprovado?">
      <bpmn:incoming>Flow_P3_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_P3_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P3_t4" name="Registrar recusa com justificativa">
      <bpmn:incoming>Flow_P3_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P3_t5" name="Invalidar ingressos e devolver estoque">
      <bpmn:incoming>Flow_P3_8</bpmn:incoming>
      <bpmn:incoming>Flow_P3_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P3_t6" name="Notificar cliente da recusa">
      <bpmn:incoming>Flow_P3_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P3_t7" name="Solicitar estorno ao provedor">
      <bpmn:incoming>Flow_P3_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P3_t8" name="Processar estorno">
      <bpmn:incoming>Flow_P3_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P3_end2" name="Solicitação recusada">
      <bpmn:incoming>Flow_P3_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P3_t9" name="Registrar reembolso e notificar cliente">
      <bpmn:incoming>Flow_P3_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P3_end1" name="Reembolso concluído">
      <bpmn:incoming>Flow_P3_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P3_0" sourceRef="P3_start" targetRef="P3_t1" />
    <bpmn:sequenceFlow id="Flow_P3_1" sourceRef="P3_t1" targetRef="P3_t2" />
    <bpmn:sequenceFlow id="Flow_P3_2" sourceRef="P3_t2" targetRef="P3_g1" />
    <bpmn:sequenceFlow id="Flow_P3_3" name="não" sourceRef="P3_g1" targetRef="P3_t3" />
    <bpmn:sequenceFlow id="Flow_P3_4" sourceRef="P3_t3" targetRef="P3_g2" />
    <bpmn:sequenceFlow id="Flow_P3_5" name="não" sourceRef="P3_g2" targetRef="P3_t4" />
    <bpmn:sequenceFlow id="Flow_P3_6" sourceRef="P3_t4" targetRef="P3_t6" />
    <bpmn:sequenceFlow id="Flow_P3_7" sourceRef="P3_t6" targetRef="P3_end2" />
    <bpmn:sequenceFlow id="Flow_P3_8" name="sim" sourceRef="P3_g1" targetRef="P3_t5" />
    <bpmn:sequenceFlow id="Flow_P3_9" name="sim" sourceRef="P3_g2" targetRef="P3_t5" />
    <bpmn:sequenceFlow id="Flow_P3_10" sourceRef="P3_t5" targetRef="P3_t7" />
    <bpmn:sequenceFlow id="Flow_P3_11" sourceRef="P3_t7" targetRef="P3_t8" />
    <bpmn:sequenceFlow id="Flow_P3_12" sourceRef="P3_t8" targetRef="P3_t9" />
    <bpmn:sequenceFlow id="Flow_P3_13" sourceRef="P3_t9" targetRef="P3_end1" />
  </bpmn:process>
